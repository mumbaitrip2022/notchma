#!/bin/bash
# CI builds with warnings as errors, so do the same before pushing app changes.
# Skip once with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
if [ -n "$upstream" ] && ! git diff --name-only "$upstream"...HEAD | grep -qE '^(Sources/|Tests/|Package\.swift)'; then
  exit 0   # no Swift changes, nothing to build
fi
echo "Building with warnings as errors, like CI…"
swift build --build-tests -Xswiftc -warnings-as-errors 2>&1 | tail -5
exit "${PIPESTATUS[0]}"
